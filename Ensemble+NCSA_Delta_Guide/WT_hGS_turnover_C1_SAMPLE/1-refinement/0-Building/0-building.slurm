#!/bin/bash
#SBATCH --job-name=______
#SBATCH --partition=gpuA40x4
#SBATCH --account=______
#SBATCH --time=00:45:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-node=1
#SBATCH --mem=32g
#SBATCH --output=building_%j.out
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=____

#this is necessary to activate emmivox and make sure all functions are call-able
source /projects/____/plumed_setup/env/activate_emmivox.sh

cd /projects/____/EMMIVox/sampleprojectfolder/1-refinement/0-Building

#runs renumber.sh on step3_input.gro and step3_input.pdb, feel free to review this shell script on your own time to review function
bash renumber.sh step3_input.gro step3_input.pdb

#this will run the python script make_ndx.py based on the NEW step3_input.gro generated by the previous step. It will select and add "protein" to System-MAP and the index file is defined as index.ndx.
#be sure to edit selection as necessary
python3 ../../../scripts/make_ndx.py step3_input.gro "(bynum 1-7204) or (bynum 86449-86516)" System-MAP --ndx index.ndx

#this will run make_XTC_ndx.py which will take in previously generated index and add hydrogens as well as carboxylates of glutamic and aspartic acids.
python ../../../scripts/make_XTC_ndx.py System-MAP-H --ndx index.ndx

#Note, for the sake of security certain fields are blank. Fill in paths and fields with information as provided.